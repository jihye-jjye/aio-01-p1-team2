DATABASE_URL=postgresql://app_api:<DB_PASSWORD>@<SUPABASE_HOST>:5432/postgres?sslmode=require
UPSTASH_REDIS_URL=rediss://default:<REDIS_PASSWORD>@<UPSTASH_HOST>:6379
JWT_SECRET_KEY=<AT_LEAST_32_RANDOM_BYTES>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ONBOARDING_SESSION_TTL_SECONDS=1800
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_VERSION=v1
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_ATTEMPTS=2
