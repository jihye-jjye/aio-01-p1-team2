PYTHON_VERSION=3.12.7

# Main LLM provider for 01~03 beginner practice.
# Check the current free tier and limits on the official Gemini screen before class.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

#Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET_KEY=<AT_LEAST_32_RANDOM_BYTES>
JWT_ALGORITHM=HS256
# Optional. Set the same values when token issuance uses iss/aud claims.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
